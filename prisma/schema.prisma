generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PromoterStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum EventBatchStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
  EXPIRED
  FAILED
}

enum PaymentProvider {
  MERCADO_PAGO
  STRIPE
  ASAAS
  PAGARME
  MANUAL
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  CANCELLED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String           @id @default(cuid())
  name            String
  email           String           @unique
  phone           String?
  document        String?          @unique
  role            UserRole         @default(USER)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  promoterProfile PromoterProfile?
  events          Event[]          @relation("EventOrganizer")
  orders          Order[]
  tickets         Ticket[]
  checkIns        TicketCheckIn[]  @relation("TicketCheckInValidator")
  idempotencyKeys IdempotencyKey[]

  @@map("users")
}

model PromoterProfile {
  id               String           @id @default(cuid())
  userId           String           @unique @map("user_id")
  status           PromoterStatus   @default(PENDING)
  displayName      String           @map("display_name")
  document         String
  companyName      String?          @map("company_name")
  payoutProvider   PaymentProvider? @map("payout_provider")
  payoutExternalId String?          @map("payout_external_id")
  pixKey           String?          @map("pix_key")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("promoter_profiles")
}

model Event {
  id          String       @id @default(cuid())
  organizerId String       @map("organizer_id")
  title       String
  slug        String       @unique
  description String?
  category    String?
  status      EventStatus  @default(DRAFT)
  startsAt    DateTime     @map("starts_at")
  endsAt      DateTime?    @map("ends_at")
  venueName   String?      @map("venue_name")
  addressLine String?      @map("address_line")
  city        String
  state       String
  country     String       @default("BR")
  imageUrl    String?      @map("image_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  organizer   User         @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  batches     EventBatch[]
  orderItems  OrderItem[]
  tickets     Ticket[]

  @@index([organizerId])
  @@index([status, startsAt])
  @@index([city, state])
  @@map("events")
}

model EventBatch {
  id               String           @id @default(cuid())
  eventId          String           @map("event_id")
  name             String
  description      String?
  status           EventBatchStatus @default(ACTIVE)
  unitPrice        Decimal          @map("unit_price") @db.Decimal(10, 2)
  currency         String           @default("BRL")
  totalQuantity    Int              @map("total_quantity")
  soldQuantity     Int              @default(0) @map("sold_quantity")
  reservedQuantity Int              @default(0) @map("reserved_quantity")
  salesStartAt     DateTime?        @map("sales_start_at")
  salesEndAt       DateTime?        @map("sales_end_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  tickets          Ticket[]

  @@index([eventId, status])
  @@map("event_batches")
}

model Order {
  id          String      @id @default(cuid())
  buyerId     String      @map("buyer_id")
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @map("total_amount") @db.Decimal(10, 2)
  currency    String      @default("BRL")
  expiresAt   DateTime?   @map("expires_at")
  paidAt      DateTime?   @map("paid_at")
  cancelledAt DateTime?   @map("cancelled_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  buyer       User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]
  tickets     Ticket[]

  @@index([buyerId, status])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String     @map("order_id")
  eventId      String     @map("event_id")
  eventBatchId String     @map("event_batch_id")
  quantity     Int
  unitPrice    Decimal    @map("unit_price") @db.Decimal(10, 2)
  totalAmount  Decimal    @map("total_amount") @db.Decimal(10, 2)
  currency     String     @default("BRL")
  createdAt    DateTime   @default(now()) @map("created_at")
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventBatch   EventBatch @relation(fields: [eventBatchId], references: [id], onDelete: Restrict)
  tickets      Ticket[]

  @@index([orderId])
  @@index([eventId])
  @@index([eventBatchId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @map("order_id")
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("BRL")
  externalPaymentId String?         @map("external_payment_id")
  externalReference String?         @map("external_reference")
  checkoutUrl       String?         @map("checkout_url")
  qrCode            String?         @map("qr_code")
  qrCodeBase64      String?         @map("qr_code_base64")
  boletoUrl         String?         @map("boleto_url")
  rawPayload        Json?           @map("raw_payload")
  paidAt            DateTime?       @map("paid_at")
  expiresAt         DateTime?       @map("expires_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalPaymentId])
  @@index([orderId])
  @@index([provider, status])
  @@map("payments")
}

model Ticket {
  id           String          @id @default(cuid())
  orderId      String          @map("order_id")
  orderItemId  String          @map("order_item_id")
  buyerId      String          @map("buyer_id")
  eventId      String          @map("event_id")
  eventBatchId String          @map("event_batch_id")
  code         String          @unique
  status       TicketStatus    @default(ISSUED)
  checkedInAt  DateTime?       @map("checked_in_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyer        User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  event        Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventBatch   EventBatch      @relation(fields: [eventBatchId], references: [id], onDelete: Restrict)
  checkIns     TicketCheckIn[]

  @@index([buyerId, status])
  @@index([eventId, status])
  @@index([orderId])
  @@map("tickets")
}

model TicketCheckIn {
  id          String   @id @default(cuid())
  ticketId    String   @map("ticket_id")
  validatorId String?  @map("validator_id")
  location    String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  validator   User?    @relation("TicketCheckInValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([validatorId])
  @@map("ticket_check_ins")
}

model OutboxEvent {
  id            String       @id @default(cuid())
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  lockedAt      DateTime?    @map("locked_at")
  processedAt   DateTime?    @map("processed_at")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([type, status])
  @@map("outbox_events")
}

model IdempotencyKey {
  id           String            @id @default(cuid())
  userId       String?           @map("user_id")
  ownerKey     String            @map("owner_key")
  scope        String
  key          String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(PROCESSING)
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  resourceType String?           @map("resource_type")
  resourceId   String?           @map("resource_id")
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, scope, key])
  @@index([userId, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
